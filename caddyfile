{
	log {
		output stdout
		level DEBUG
	}
	servers {
		timeouts {
			read_body 5m
			read_header 5m
			write 5m
			idle 5m
		}
	}
}

http://localhost {
	header {
		Access-Control-Allow-Origin *
		Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
		Access-Control-Allow-Headers "Authorization, Content-Type, X-CSRF-Token"
		Access-Control-Allow-Credentials true
	}
	reverse_proxy /api/* gateway:3001
}

https://localhost {
	header {
		Access-Control-Allow-Origin *
		Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
		Access-Control-Allow-Headers "Authorization, Content-Type, X-CSRF-Token"
		Access-Control-Allow-Credentials true
	}
	reverse_proxy /api/* gateway:3001
}

http://auth.localhost {
	reverse_proxy /api/* auth:12345
	reverse_proxy /docs/* auth:12345
	reverse_proxy /swagger/* auth:12345
}

https://auth.localhost {
	reverse_proxy /api/* auth:12345
	reverse_proxy /docs/* auth:12345
	reverse_proxy /swagger/* auth:12345
}

https://files.localhost {
	reverse_proxy files:50051
}

http://files.localhost {
	reverse_proxy files:50051
}

hello.localhost {
	respond "Hello, World!"
}
